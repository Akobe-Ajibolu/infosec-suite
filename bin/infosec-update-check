#!/usr/bin/env bash
# infosec-update-check — check if InfoSec-Suite has upstream updates
#
# Output (one line, stdout):
#   UP_TO_DATE <version>               — already on latest
#   UPGRADE_AVAILABLE <version> <N>    — N commits available upstream
#   NO_REMOTE                          — no git remote / not a git repo
#
# Caches result for 24h under ~/.infosec-suite/.last-update-check.
# Pass --force to bypass cache.

set -euo pipefail

SUITE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE_DIR="$HOME/.infosec-suite"
CACHE_FILE="$CACHE_DIR/.last-update-check"
CACHE_TTL=86400  # 24 hours

FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

VERSION="$(cat "$SUITE_DIR/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")"

# --- cache check -----------------------------------------------------------
if [ "$FORCE" = "0" ] && [ -f "$CACHE_FILE" ]; then
  NOW=$(date +%s)
  CACHED_AT=$(awk '{print $1}' "$CACHE_FILE" 2>/dev/null || echo 0)
  AGE=$(( NOW - CACHED_AT ))
  if [ "$AGE" -lt "$CACHE_TTL" ]; then
    CACHED_RESULT=$(awk 'NF>1{$1=""; sub(/^ /,""); print}' "$CACHE_FILE" 2>/dev/null || echo "")
    if [ -n "$CACHED_RESULT" ]; then
      echo "$CACHED_RESULT"
      exit 0
    fi
  fi
fi

# --- git check -------------------------------------------------------------
cd "$SUITE_DIR"

if ! git rev-parse --git-dir &>/dev/null 2>&1; then
  echo "NO_REMOTE"
  exit 0
fi

REMOTE=$(git remote 2>/dev/null | head -1 || echo "")
if [ -z "$REMOTE" ]; then
  echo "NO_REMOTE"
  exit 0
fi

# Fetch silently; treat network failures as non-fatal
git fetch "$REMOTE" --quiet 2>/dev/null || {
  echo "NO_REMOTE"
  exit 0
}

LOCAL_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "master")
REMOTE_SHA=$(git rev-parse "$REMOTE/$BRANCH" 2>/dev/null || echo "")

if [ -z "$LOCAL_SHA" ] || [ -z "$REMOTE_SHA" ]; then
  echo "NO_REMOTE"
  exit 0
fi

if [ "$LOCAL_SHA" = "$REMOTE_SHA" ]; then
  RESULT="UP_TO_DATE $VERSION"
else
  BEHIND=$(git rev-list --count HEAD.."$REMOTE/$BRANCH" 2>/dev/null || echo "?")
  RESULT="UPGRADE_AVAILABLE $VERSION $BEHIND"
fi

# --- write cache -----------------------------------------------------------
mkdir -p "$CACHE_DIR"
echo "$(date +%s) $RESULT" > "$CACHE_FILE"
chmod 600 "$CACHE_FILE" 2>/dev/null || true
echo "$RESULT"
